            "commandWindows": "py -3 -I -S -c \"import base64;exec(compile(base64.b64decode(''),'<drydock-inline-verifier>','exec'))\"",
            "statusMessage": "Checking Drydock guardrails",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "command": "python3 -I -S -c \"import base64;exec(compile(base64.b64decode(''),'<drydock-inline-verifier>','exec'))\"",
            "commandWindows": "py -3 -I -S -c \"import base64;exec(compile(base64.b64decode(''),'<drydock-inline-verifier>','exec'))\"",
            "statusMessage": "Checking Drydock guardrails",
            "timeout": 15,
            "type": "command"
          }
